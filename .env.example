# Supabase project settings → API
# https://supabase.com/dashboard/project/_/settings/api
#
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Service-role key. Bypasses Row Level Security, so it is used ONLY by the local
# seed script (scripts/seed.ts). Never import it from app code and never add it to
# Vercel's environment variables.
SUPABASE_SECRET_KEY=your-service-role-secret-key
